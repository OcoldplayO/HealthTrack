# 编译生成的可执行文件与临时文件
/bin/
*.exe
*.exe~
*.dll
*.so
*.dylib

# SQLite 本地数据库文件与热日志（严禁提交个人隐私数据）
/data/*.db
/data/*.db-journal
/data/*.db-wal
/data/*.db-shm
/data/backups/
!/data/.gitkeep

*.db
*.db-journal
*.db-wal
*.db-shm
backups/

# 敏感配置文件（包含大模型 API Key，严禁提交到代码仓）
config.yaml
.env
*.local.yaml

# 编辑器与操作系统缓存
.idea/
.vscode/
*.swp
*~
.DS_Store
Thumbs.db

# Android 签名密钥（私钥，泄露等于他人可伪造本应用的更新包）
*.jks
*.keystore

# Android Gradle 临时缓存与输出目录
.gradle/
android/.gradle/
android/build/
android/app/build/
android/local.properties
*.log

# 本地打包/安装脚本（含本机签名口令与绝对路径，严禁提交）
scripts/build-android.ps1